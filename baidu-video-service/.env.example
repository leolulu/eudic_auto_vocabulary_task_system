# Public API: no credentials required. All settings below are optional.
BAIDU_VIDEO_TIMEOUT_MS=20000
BAIDU_VIDEO_UPSTREAM_TIMEOUT_MS=10000
BAIDU_VIDEO_CACHE_TTL_SECONDS=3600
BAIDU_VIDEO_NEGATIVE_CACHE_TTL_SECONDS=300
BAIDU_VIDEO_CACHE_MAX_ENTRIES=256
BAIDU_VIDEO_MAX_INFLIGHT=4
# Default allows all browser origins. Exact origins may be listed instead.
BAIDU_VIDEO_ALLOWED_ORIGINS=*
